 // BMH 2025-01-02 to override ZC admin settings in stylesheet.css

 */
body {
    font-family: 'Noto Sans', sans-serif;
    font-size: 13px;
}
.messageStackAlert {
    font-size: .75em;
}

.alert {    padding: 2px;}
#adminHeaderLogo {
    padding: 1px;
    width: 10%;
}
.adminHeaderAlerts {
    padding: 0px;
}
.row {
    margin: 0;
}

a, body, html, table { 
   font-style:normal;}

.dataTableRow {
    background-color: #eee;
}
/*
.dataTableContent {
    padding: 0px;
}
.table>tbody>tr>td.dataTableContent { padding: 2px;}
*/
.table>tbody>tr>td, .table>tbody>tr>th, .table>tfoot>tr>td, 
    .table>tfoot>tr>th, .table>thead>tr>td, .table>thead>tr>th {
     padding: 2px;
    }
    
    /* invoice settings */ /* BMH 2020-11-07 */ /* + packingslip */
.table-invoice {
  margin-bottom: 0;
  border: 0;
  width: 90%;
}
.pageHeadingL {width: 50%; font-size: 1rem; font-weight:600;}
.pageHeadingR {height:5em;}
.pageHeadingR { width: 50%; float: right;}
.pageHeadingR img { width:100%;}
.pageHeadingTax {font-size:1.75rem; text-align:left !important;}

.main-ship-name {font-size:1.5rem; width: 90%;}
.main-address1 {font-size: 1.25rem;}
.table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {   padding: 3px;   /* line-height: 100%; */ }
.table {margin-bottom: 0.5em;}
table:last-child td, table tbody:last-child td {   padding-bottom: 0; }
.td-lh {width: 55%; /*width:63%;*/ border-top: none !important;}