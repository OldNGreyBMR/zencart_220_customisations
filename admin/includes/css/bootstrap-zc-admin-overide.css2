/* override default admin css
*  BMH 2025-11-12 for zc220
*/
/* **** Product in Category editing  bof ************* */
.container-fluid-well { min-height: 2%; padding: 0%; margin-bottom: 0%; /*line-height: 0.75rem;*/}
.container-fluid-well h2 { font-size: 1.75rem; } /* for products edit */
.container-fluid-well h3 { font-size: 1.25rem; font-weight:700; }

textarea.cke_source {
    line-height: 1.1em;
    font-size: 1em;
}

div.form-group {margin-bottom:2px;}

.well-green { background-color: #B7FFB7;}
.well-green::before {
    /* display: inline-block;
    */
    content: "";
    border-top: .1rem solid black;
    width: 100%;
    margin: 0 ;
    transform: translateY(-1rem);}


form.form-horizontal h2 {font-size: 1.5em; font-weight: 600;}
/* form.form-horizontal hr {color:gray; border-bottom:solid;}
*/
.form-horizontal .checkbox, .form-horizontal .checkbox-inline, .form-horizontal .radio,
    .form-horizontal .radio-inline {
padding-top: 1%; margin-bottom: 0;
min-height:10px; }

.col-sm-9.notify {
    display: flex;
}




div.well-green h2 {font-size: 1.5em; font-weight: 600;}
/*
div.well-green div.form-group .control-label{line-height: 0.8em; margin:0; padding-top:0;}
*/

div.well-green .radio-inline::after {content: ""; padding-bottom: 1em;}

.alert {    padding: 2px;}
.ck.ck-editor__main>.ck-editor__editable {
    font-size: 1.2rem;
    line-height: 1.4rem;
}

/* Horizontal rules */
/* overwrite scaffolding.less */

.form-horizontal hr {
    margin-top: 0px;
    margin-bottom: 0px;
    border: 0;
    border-top: 2.5px solid lightgray; 
}
/* Configuration pages */
.form-horizontal div.row.font-weight-bold {
    font-size: 1.3rem; 
    background-color: lightgray;
}

div.row.row-hover.align-items-center.py-2 div.col-md-6 {
    background-color:#d2f2f2 ; /*paleturquoise */
    }

.row-title {background-color:lightgray;}

textarea.form-control {
    height: 7rem;
    max-height:12rem;
}
input[type=checkbox], input[type=radio] {
margin: 0; }

@media (max-width: 767px) {        
 .form-control {
  margin-bottom: .5rem; 
 }